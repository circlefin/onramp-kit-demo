# Kit key from the Circle console, in the form KIT_KEY:<keyId>:<keySecret>
ONRAMP_KIT_KEY=KIT_KEY:your-key-id:your-key-secret

# Sandbox endpoints. Keep these set unless you intend to move real money:
# removing them targets Circle's production API and widget on mainnet.
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# The widget is embedded in the page by default. Set to 0 or false to open it
# in a popup instead. Read at build time, so restart `npm run dev` after
# changing it.
# NEXT_PUBLIC_EMBEDDED_ONRAMP=0
